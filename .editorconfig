root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ktlint_standard_filename = disabled
# Public internal factory helpers (e.g. Close(...)) read better capitalised.
ktlint_standard_function-naming = disabled

[*.{yml,yaml,json,toml}]
indent_size = 2
